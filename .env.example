# Copy to .env; Pagepack loads it automatically without overriding exported settings.
HTTP_ADDR=localhost:8000
# Optional published host port for Docker Compose (container stays on 8000).
# PAGEPACK_PORT=8000
MAX_WEBSITE_BYTES=104857600
MAX_CONCURRENT_JOBS=4
JOB_TIMEOUT=15m
STATE_TTL=24h
DOWNLOAD_TTL=15m
# Downloaded pages, assets, and ZIPs go here in private per-job directories.
# Created automatically; relative paths resolve from the server working directory.
TEMP_DIR=./tmp/pagepack
WGET_PATH=wget
# Timeout for DNS/connect/read inactivity (not total time per file).
WGET_TIMEOUT=10s
# Total attempts per link. One skips stalled links without retrying.
WGET_TRIES=1
# debug | info | warn | error
LOG_LEVEL=info
# pretty (coloured terminal) | json | text
LOG_FORMAT=pretty

# valkeys:// enables TLS; redis:// and rediss:// are also accepted.
VALKEY_URL=valkey://localhost:6379/0

AWS_BUCKET=pagepack-temp
AWS_REGION=us-east-1
# Omit credentials to use the AWS SDK default credential chain (e.g. an IAM role).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_BUCKET_PATH=clones/
# For S3-compatible providers such as MinIO:
# AWS_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=false
